<?xml version="1.0" encoding="utf-8"?>
<Map background-color="white">
  <FileSource name="symbols">./symbols</FileSource>

  <Style name="style">
    <Rule>
      <Filter>[file] != ""</Filter>
      <MarkersSymbolizer base="symbols" file="[file]"/>
      <TextSymbolizer face-name="DejaVu Sans Book" dy="20">[file]</TextSymbolizer>
    </Rule>
    <Rule>
      <ElseFilter/>
      <MarkersSymbolizer/>
      <TextSymbolizer face-name="DejaVu Sans Book" dy="20">default</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="layer">
    <StyleName>style</StyleName>
    <Datasource>
      <Parameter name="type">csv</Parameter>
      <Parameter name="inline">
wkt,file
"POINT(0 0)",""
"POINT(1 0)","dot.svg"
"POINT(2 0)","bug.svg"
      </Parameter>
    </Datasource>
  </Layer>

</Map>

