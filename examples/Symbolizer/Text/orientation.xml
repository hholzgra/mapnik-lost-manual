<?xml version="1.0" encoding="utf-8"?>
<Map background-color="white">
  <Style name="style">
    <Rule>
      <MarkersSymbolizer fill="red" width="6" height="6" stroke-width="0"
                         allow-overlap="true"/>
      <TextSymbolizer face-name="DejaVu Sans Book" size="14" allow-overlap="true"
                      dx="15" orientation="[angle]"
                      rotate-displacement="[rotate]">[angle]+"°"</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="layer">
    <StyleName>style</StyleName>
    <Datasource>
      <Parameter name="type">csv</Parameter>
      <Parameter name="inline">
wkt,angle,rotate
"POINT(0 0)",0,false
"POINT(4 0)",45,false
"POINT(8 0)",90,false
"POINT(12 0)",180,false
"POINT(0 -4)",0,true
"POINT(4 -4)",45,true
"POINT(8 -4)",90,true
"POINT(12 -4)",180,true
      </Parameter>
    </Datasource>
  </Layer>

</Map>
