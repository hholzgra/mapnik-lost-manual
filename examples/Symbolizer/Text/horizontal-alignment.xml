<?xml version="1.0" encoding="utf-8"?>
<Map background-color="white">
  <Style name="point-style">
    <Rule>
      <MarkersSymbolizer fill="red" width="6" height="6" stroke-width="0"
                         allow-overlap="true"/>
      <TextSymbolizer face-name="DejaVu Sans Book" size="16" allow-overlap="true"
                      horizontal-alignment="[align]">[align]</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="point-layer">
    <StyleName>point-style</StyleName>
    <Datasource>
      <Parameter name="type">csv</Parameter>
      <Parameter name="inline">
align,wkt
left,"POINT(-10 40)"
middle,"POINT(-10 30)"
right,"POINT(-10 20)"
      </Parameter>
    </Datasource>
  </Layer>

  <Style name="line-style">
    <Rule>
      <LineSymbolizer stroke="lightblue" stroke-width="20"/>
      <TextSymbolizer face-name="DejaVu Sans Book" size="20" placement="line"
                      horizontal-alignment="[align]">"horizontal-alignment "+[align]</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="line-layer">
    <StyleName>line-style</StyleName>
    <Datasource>
