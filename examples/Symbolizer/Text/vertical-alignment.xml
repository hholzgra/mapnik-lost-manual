<?xml version="1.0" encoding="utf-8"?>
<Map background-color="white">
  <Style name="style">
    <Rule>
      <MarkersSymbolizer fill="red" width="6" height="6" stroke-width="0"
                         allow-overlap="true"/>
      <TextSymbolizer face-name="DejaVu Sans Book" size="16" allow-overlap="true"
                      vertical-alignment="[align]">[align]</TextSymbolizer>
    </Rule>
  </Style>

  <Layer name="layer">
    <StyleName>style</StyleName>
    <Datasource>
      <Parameter name="type">csv</Parameter>
      <Parameter name="inline">
wkt,align
"POINT(0 0)",top
"POINT(4 0)",middle
"POINT(8 0)",bottom
      </Parameter>
    </Datasource>
  </Layer>

</Map>
